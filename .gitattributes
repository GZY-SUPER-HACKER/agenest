* text=auto

# Shell scripts and the generated extension files are run by tools that do not tolerate CRLF.
*.sh   text eol=lf
*.py   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.service text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf

# Binary-ish assets
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.sqlite3 binary
