{
  "name": "agenest-dashboard",
  "private": true,
  "version": "0.1.0",
  "description": "Agenest — phone-first dashboard for coding-agent sessions",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check:rail": "esbuild src/lib/rail-tree.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/rail-tree.mjs && node scripts/check-rail-tree.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^8.3.4"
  }
}
