# Agenest — environment template.
#
# Copy to /etc/csd/csd.env and fill in. The systemd unit reads it as an EnvironmentFile,
# which means KEY=value lines only: no `export`, no quotes needed, no shell expansion.
#
#   cp .env.example /etc/csd/csd.env
#   chmod 600 /etc/csd/csd.env      # it contains the ingest token
#   chown root:root /etc/csd/csd.env
#
# The token must never be committed, echoed, or written into a second file. The CLI reads it
# from its own environment, so the client and the server never share a copy.

# --- required ---------------------------------------------------------------

# Bearer token the reporting CLI must present to write. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The service refuses to start without it (see backend/app/config.py).
CSD_INGEST_TOKEN=replace-me-with-a-generated-token

# --- bind address -----------------------------------------------------------

# Loopback only. This is the safe default: the service is then reachable through an SSH
# tunnel and through nothing else.
CSD_HOST=127.0.0.1
CSD_PORT=8780

# To bind the Tailscale address instead (spec 2.3), resolve it first:
#   CSD_HOST=$(tailscale ip -4)
# Verify it is the tailnet address and not the public one before switching, and confirm the
# security group does not expose it. Run deploy/scripts/tailscale-prefly.sh first.

# --- storage ----------------------------------------------------------------

# SQLite lives here. It is the only durable state; nothing else is written.
CSD_DB_PATH=/srv/csd/data/csd.sqlite3

# --- dashboard --------------------------------------------------------------

# Absolute path to the built frontend (frontend/dist, produced by `npm run build`).
# Leave unset to serve the API only, which is a valid configuration.
CSD_STATIC_DIR=/srv/csd/static

# --- optional ---------------------------------------------------------------

# A second token that gates READ access. Optional, but **required if the dashboard is
# reachable from the public internet** — which it is when Tailscale Funnel is on
# (`tailscale funnel --bg 8780`). On a tailnet-only or SSH-tunnel-only deployment, leaving it
# unset is the right call: a required token there means typing one on a phone for no security
# gained.
#
# When set, the app prompts for it in the browser and keeps it in localStorage. It is never
# compiled into the bundle — the bundle is public, so a baked-in token would be published.
# The SSE stream sends it as `?token=`, because EventSource cannot set headers; REST uses the
# header. The ingest token above is never accepted from a query string, because it can write.
#
# CSD_DASHBOARD_TOKEN=

# How long a running session must be quiet before the UI labels it "maybe offline".
# Purely cosmetic: the stored status is never rewritten from this (spec 4.2).
CSD_STALE_AFTER_SECONDS=900

# A third credential, for the few actions that *change the record* from the UI — currently
# just closing a session nothing is going to report on. Unset means the action is switched
# off (the endpoint answers 403), not open. That is the opposite of CSD_DASHBOARD_TOKEN
# above, and deliberately: a missing read token leaving reads open costs nothing on a private
# deployment, while a missing write token leaving writes open would let anyone edit the record.
#
# It is separate from the ingest token because the dashboard's UI is served to anyone who
# loads the URL. A button in it must not be backed by the credential that creates sessions
# and writes arbitrary events. That is also why it is enforced by *presence*: see access_header.

# Cap on a single event's payload, applied by truncating rather than rejecting (spec 8.9).
CSD_PAYLOAD_MAX_CHARS=8000

# Only needed if the built frontend is served from a different origin than the API.
# CSD_CORS_ORIGINS=https://dashboard.example

# ============================================================================
# agenest — a channel onto your own agent (docs/design.md §17)
#
# This service is a CLIENT of an agent, not an agent. By default it connects to a nanobot
# gateway you already run; the agent's memory, models, tools and workspace all stay there.
# Read §17 before enabling any of this.
# ============================================================================

# There is no agent token: /api/agent/* requires CSD_DASHBOARD_TOKEN to *exist* (403 without
# it, reads still open) — one credential for the page, per docs/design.md §22. The promise is
# narrower than it looks: holding it lets you talk to your agent, and what that agent may do is
# decided by the agent's own configuration — its workspace, its ssh keys, its MACHINES.md.
#
# The agent stream does NOT accept the token as a query parameter (see auth.py), which is why
# the agent page consumes its SSE with fetch() rather than EventSource: those routes can execute.

# Which agent to talk to: `native` (a Pi process this service runs itself — the default, and
# the only one that needs nothing but a provider key) or `nanobot` (a gateway you already run,
# registered through the settings panel). Leaving this unset means `native`.
# CSD_AGENT_BACKEND=nanobot

# One short progress line per stage, in the message that carries that stage's tool calls —
# a checkpoint rather than a per-tool-call feed. 0 turns the narration off.
CSD_AGENT_PROGRESS=1

# A file naming the machines the agent may `ssh` to, and where the code is on them. Appended to
# its system prompt on every message. Defaults to <workspace>/MACHINES.md. This is *your* prose;
# the machines file the service generates (MACHINES.registered.md, design.md §24) sits beside it
# and lists what the registry knows and which hosts you have authorized.
# CSD_AGENT_MACHINES_FILE=/srv/code/MACHINES.md

# Where keys minted for approved hosts are kept. Defaults to $HOME/.ssh, which under the unit is
# the agent's own home — the directory `ssh` already looks in — so this usually needs no change.
# Keys are written 0600 and are never sent to a host: the connector installs the public half only.
# CSD_AGENT_KEY_DIR=/srv/csd/data/agent-home/.ssh

# --- nanobot backend ---------------------------------------------------------

# The gateway's websocket channel. 8765 is nanobot's default and the channel is enabled by
# default, so this usually needs no change — `nanobot gateway` and you are done. An address
# the agent registered itself (Settings → Agent, or POST /api/agent/backends) wins over this.
CSD_NANOBOT_WS_URL=ws://127.0.0.1:8765/

# Identifies THIS dashboard to nanobot, for its `allowFrom` allow-list. Stable by default:
# a random id per launch could never be allow-listed in advance.
CSD_NANOBOT_CLIENT_ID=csd-dashboard

# nanobot's credential for that door, when one is configured: either a static
# `channels.websocket.token`, or the `channels.websocket.tokenIssueSecret` the gateway's
# `/webui/bootstrap` route asks for before it mints a one-time socket token (which is what this
# backend normally uses). This is *nanobot's* credential and is scoped to nanobot — unlike
# CSD_DASHBOARD_TOKEN, leaking it grants nothing on this host.
#
# CSD_NANOBOT_TOKEN=

# --- openclaw backend --------------------------------------------------------
#
# OpenClaw's Gateway WebSocket. Loopback plus the Gateway's shared token needs nothing
# else; a remote or untokened Gateway answers with PAIRING_REQUIRED and the page tells you
# to run this on the Gateway host: `openclaw devices approve <requestId>`.

CSD_OPENCLAW_WS_URL=ws://127.0.0.1:18789/

# The Gateway's shared token, when it has one. Verified against a real 2026.10.4 Gateway:
# set one with `openclaw config set gateway.auth.mode token` and
# `openclaw config set gateway.auth.token <token>`. Without one the Gateway generates a
# fresh runtime token on every start and does not write it to config, so nothing outside the
# Gateway — this service included — can know it.
#
# CSD_OPENCLAW_TOKEN=

# Capabilities this client advertises. `tool-events` is what makes the Gateway send live
# tool activity at all — it does NOT error when it is missing, it simply goes quiet, which
# looks like "this agent has no tools".
CSD_OPENCLAW_CAPS=tool-events

# --- hermes backend ----------------------------------------------------------
#
# Hermes' **API server** (HTTP + SSE), not the Desktop app's private WebSocket: that one is
# gated by short-lived tickets minted over a same-OS-user control socket, and building on
# another product's inner surface is the dependency §17 rejects. Turn this one on in Hermes:
#
#   API_SERVER_ENABLED = true
#   API_SERVER_KEY = <shared secret>
#
# and, if you installed Hermes from PyPI rather than with its own installer, one dependency
# it does not pull in by itself — without this the gateway starts and the API surface is
# simply dead, with `WARNING API Server: aiohttp not installed`:
#
#   pip install aiohttp
#
# Turns go through the **Runs API** (`POST /v1/runs` + `GET /v1/runs/{id}/events`), not Chat
# Completions, and the difference is the stop button: only a run can be stopped. A Chat
# Completions turn names a `chatcmpl-…` completion and `POST /v1/runs/{id}/stop` refuses it
# with `404 run_not_found` — verified against a live server. Runs also report a tool's
# `error` flag and its `duration`, and carry `reasoning.available`, none of which Chat
# Completions sends.

CSD_HERMES_API_URL=http://127.0.0.1:8642

# The same `API_SERVER_KEY`, sent as a bearer token. Required to be useful: without it every
# request is a 401, so the settings row reports the credential as missing rather than
# inviting you to check whether the server is running.
#
# Note that `/health` is *unauthenticated* on a real Hermes server — a wrong key still gets a
# 200 there — so this service also checks the key against `/api/sessions` at startup. That is
# what lets the settings row say "the key is wrong" instead of showing a healthy connection.
#
# CSD_HERMES_API_KEY=

# The model name the OpenAI-compatible surface expects. `hermes-agent` selects Hermes' own
# configured provider rather than naming a vendor's model — the model is the agent's
# business, not the channel's.
CSD_HERMES_MODEL=hermes-agent

# --- native backend ----------------------------------------------------------
#
# Only used when CSD_AGENT_BACKEND=native. This one DOES run a process on this host, with
# Pi's tools (bash among them) under this service's user. Read §17.

# The command that starts Pi in RPC mode, as an argv list (parsed with shlex, so quoting
# works). Pi must be installed separately: npm i -g @earendil-works/pi-coding-agent
# CSD_PI_BIN=pi

# Extra argv appended after `--mode rpc`, e.g. --thinking high or --no-skills.
# CSD_PI_ARGS=

# The directory the agent works in. Set this deliberately.
#
# It is NOT defaulted to the repository root on purpose: an agent with `bash` enabled that
# silently starts with write access to this service's own source is not a default anyone
# should inherit. `dev.sh` uses backend/data/agent-workspace unless you override it.
#
# CSD_PI_WORKSPACE=/home/you/code

# Where Pi keeps its JSONL session files. Defaults to a `pi-sessions/` directory beside the
# database.
# CSD_PI_SESSION_DIR=/srv/csd/data/pi-sessions

# Pi's own default provider is google. Leaving these unset therefore lands on a provider most
# people have no key for, which surfaces as an upstream auth error rather than as "you did not
# configure a model". Set at least one. `--model` accepts `provider/id` and an optional
# `:<thinking>` suffix (e.g. `anthropic/claude-sonnet-4:high`).
#
# **These are the fallback, not the last word.** The Agent tab's settings panel (gear on the
# agenest row) can set the provider, model, API key, a custom base URL and the tool allowlist at
# runtime; a stored value wins, and clearing a field comes back to these (docs/design.md §26).
# The working directory is deliberately not in that panel.
#
# The provider's own key comes from the environment too — DEEPSEEK_API_KEY,
# ANTHROPIC_API_KEY, OPENAI_API_KEY, and so on. Export it for the service, not just for your
# shell: the systemd unit only sees what its EnvironmentFile gives it.
#
# CSD_PI_PROVIDER=deepseek
# CSD_PI_MODEL=deepseek/deepseek-chat

# Comma-separated tool allowlist, passed through to Pi's `--tools`. Empty means Pi's default,
# which is every built-in tool **including bash**.
#
# To run read-only — it can look at your code and answer questions, but cannot change
# anything — set:
#   CSD_PI_TOOLS=read,grep,find,ls
#
# CSD_PI_TOOLS=

# How long to wait for Pi to acknowledge a command. Pi answers a prompt as soon as it is
# accepted, so this bounds acknowledgement, not the length of a run.
CSD_PI_COMMAND_TIMEOUT=30

# Idle compaction. There is one conversation per agent and it never ends, so its context only
# grows; Pi compacts on its own when the window is nearly full, and this is the proactive half —
# run after nobody has said anything for a while, when a summary call costs nobody a wait.
#
# Only a process that is already running is asked (never spawn one to compact), never mid-turn
# (Pi's manual compact aborts the current operation first), and only once per new message.
# `0` disables it.
CSD_AGENT_IDLE_COMPACT_MINUTES=15
CSD_AGENT_IDLE_COMPACT_CHECK_SECONDS=60

# --- memory (docs/design.md §18) ---------------------------------------------
#
# The long-term memory of an agent this service runs itself (`native`). It is copied in shape
# from nanobot's and is not nanobot's: a gateway agent keeps its own memory on its own host, and
# nothing here touches it.
#
# Two layers. A **journal** is written as runs finish — one entry per settled run, derived from
# Pi's own session file (the transcript belongs to the agent; this service keeps no copy).
# **Dream** is a second Pi process that reads the unconsumed entries and edits the memory files
# surgically, committing the result to a git repository of its own so the change is auditable.
#
# The agent reads the memory back through a Pi extension that re-reads it on **every prompt**
# (`backend/app/agent/pi/recall.ts`), so a Dream reaches the agent on its next message rather
# than on its next process start.
#
# The memory files live here:

# Where MEMORY.md, USER.md, SOUL.md and the journal go. Defaults to a `memory/` inside
# CSD_PI_WORKSPACE, so the memory follows the agent rather than the database and can be read
# with `ls`. Set this only to put it somewhere else.
#
# CSD_MEMORY_DIR=/srv/csd/data/memory

# Hours between automatic Dream runs. **On by default, at nanobot's own interval (2).**
#
# Dream spends model budget and edits files, so this is the knob for what the memory costs. It is
# on because the agent now re-reads the memory on every prompt: a layer nobody switches on is a
# layer that does not exist, and every answer would be missing it with nothing on screen to say
# so. Set 0 to turn the schedule off and run `POST /api/agent/memory/dream` by hand, or raise it
# to spend less.
CSD_MEMORY_INTERVAL_H=2

# How many journal entries one Dream run reads. Bounds a single run's reading; a long backlog is
# consumed over several runs rather than in one enormous prompt.
CSD_MEMORY_DREAM_BATCH=20

# Skip journalling a run whose transcript is shorter than this. A greeting is not memory, and
# summarising one buries the useful entries under noise.
CSD_MEMORY_JOURNAL_MIN_CHARS=400

# The model Dream runs on. Unset means the agent's own model (CSD_PI_MODEL), which is the right
# default: Dream reads the same files it curates, and a different model would read a different
# dialect of them.
#
# CSD_MEMORY_MODEL=deepseek/deepseek-chat
